            "lineId": "init-left",
            "text": "int left = 0;"
          },
          {
            "lineId": "init-right",
            "text": "int right = n - 1;"
          },
          {
            "lineId": "loop-check",
            "text": "while (left <= right) {"
          },
          {
            "lineId": "calc-mid",
            "text": "  int mid = left + (right - left) / 2;"
          },
          {
            "lineId": "probe-match",
            "text": "  if (arr[mid] == target) {"
          },
          {
            "lineId": "found",
            "text": "    return mid;"
          },
          {
            "lineId": "probe-less",
            "text": "  } else if (arr[mid] < target) {"
          },
          {
            "lineId": "update-left",
            "text": "    left = mid + 1;"
          },
          {
            "lineId": "probe-greater",
            "text": "  } else {"
          },
          {
            "lineId": "update-right",
            "text": "    right = mid - 1;"
          },
          {
            "lineId": "loop-end",
            "text": "  }"
          },
          {
            "lineId": "loop-end-2",
            "text": "}"
          },
          {
            "lineId": "not-found",
