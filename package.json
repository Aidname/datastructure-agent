{
  "name": "datastructure-agent",
  "version": "0.0.1",
  "private": true,
  "description": "看懂每一步：二分查找可视化、步骤辅导与过程练习",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/src/server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "node tests/backend-acceptance.mjs",
    "check:content": "node content/validate.mjs"
  }
}
